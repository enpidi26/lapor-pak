# Contoh konfigurasi untuk server produksi.
# Salin menjadi .env di server, lalu isi semua nilai yang kosong.
# Berkas .env asli tidak boleh diunggah ke repositori.

APP_NAME="Lapor Pak"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://laporpak.contoh.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# Gunakan basis data yang persisten (MySQL atau PostgreSQL).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lapor_pak
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# --- Lapor Pak --------------------------------------------------------------

RT_NAMA="RT 04 / RW 07"
RT_KELURAHAN="Kelurahan Sukamaju"
RT_WHATSAPP=
RT_JAM_TINJAU=24

# Akun pengurus pertama. Kata sandi minimal 12 karakter dan memuat huruf
# besar, huruf kecil, angka, serta simbol. Jangan memakai kata sandi demo.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Matikan seluruh jalur pratinjau di server produksi.
LAPOR_DEMO_AKTIF=false
